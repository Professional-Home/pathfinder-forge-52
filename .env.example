VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-key
VITE_SUPPORT_WHATSAPP=919876543210

# Cloudinary Image Upload
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Colony Detection ML API (Python FastAPI + YOLO)
# In development: defaults to http://localhost:8000
# In production: MUST be explicitly set to the public microservice URL (e.g. https://colony-api.biotech.micrylis.com).
# Production builds without VITE_COLONY_ML_API_URL fail safely with a descriptive configuration error.
VITE_COLONY_ML_API_URL=http://localhost:8000

# Server-only secrets (NO VITE_ prefix — never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
