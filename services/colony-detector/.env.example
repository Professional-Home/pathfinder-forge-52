# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
# Environment mode: 'development' or 'production'
# In production, FRONTEND_ORIGIN is strictly required and wildcard '*' is rejected.
ENVIRONMENT=development

# Allowed Frontend Origins for CORS (comma-separated, no trailing slashes)
# In production, provide explicit public origin(s), e.g.: https://biotech.micrylis.com
FRONTEND_ORIGIN=http://localhost:8080,http://localhost:5173

# YOLO Model Path (Relative to services/colony-detector or absolute filesystem path)
COLONY_MODEL_PATH=models/best.pt

# Public Base URL (Used for generating URLs for server-annotated output images)
# If omitted behind a reverse proxy, the service checks X-Forwarded-Proto/Host or request base URL
PUBLIC_BASE_URL=http://localhost:8000

# Rate Limiting & Reverse Proxy Configuration
# Throttles computationally heavy YOLO inference per client IP (Token Bucket algorithm)
COLONY_RATE_LIMIT_ENABLED=true
COLONY_RATE_LIMIT_REQUESTS=10
COLONY_RATE_LIMIT_WINDOW_SECONDS=60
COLONY_RATE_LIMIT_BURST=10
# Comma-separated list of trusted reverse proxy IPs/CIDRs (e.g., 127.0.0.1,10.0.0.1).
# Only requests arriving from these direct IPs will have their X-Forwarded-For header evaluated.
COLONY_TRUSTED_PROXIES=

# Periodic Output Artifact Cleanup Configuration
# Evicts older annotated JPEG files to prevent unbounded disk growth.
COLONY_OUTPUT_CLEANUP_INTERVAL_SECONDS=600
MAX_OUTPUT_AGE_SECONDS=3600
MAX_OUTPUT_FILES=50
