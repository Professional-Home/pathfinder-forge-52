# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Allowed Frontend Origins for CORS (comma-separated)
# Matches TanStack Start default port (8080) and standard Vite port (5173)
FRONTEND_ORIGIN=http://localhost:8080,http://localhost:5173

# YOLO Model Path (Relative to services/colony-detector or absolute filesystem path)
COLONY_MODEL_PATH=models/best.pt

# Public Base URL (Used for generating URLs for server-annotated output images)
PUBLIC_BASE_URL=http://localhost:8000

# Periodic Output Artifact Cleanup Interval (Seconds)
# Default is 600s (10 minutes) to match the 1-hour MAX_OUTPUT_AGE_SECONDS retention policy
COLONY_OUTPUT_CLEANUP_INTERVAL_SECONDS=600
